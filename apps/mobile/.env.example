# Public configuration only — never put secrets in EXPO_PUBLIC_* variables.
# Android emulators reach your machine via http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# EAS project id — required for push notifications (get one with `eas init`).
# Without it the app skips push registration and only receives calls/messages
# while online.
EXPO_PUBLIC_EAS_PROJECT_ID=
