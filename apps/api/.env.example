# Phoenix API environment
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://phoenix:phoenix@localhost:5432/phoenix
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=*

# Local folders (relative to apps/api, absolute paths also accepted)
THUMBNAILS_DIR=../thumbnails
UPLOADS_DIR=../uploads
DIGITAL_FILES_DIR=../digital-files

# Payments
PAYMENT_PROVIDER=simulated
PAYMENT_WEBHOOK_SECRET=
MAX_UPLOAD_MB=25

# App lock — the app blocks itself every 3 days until the window's 6-character
# code is entered. APP_LOCK_SECRET derives the codes (HMAC of the window index);
# APP_LOCK_ADMIN_KEY guards GET /api/v1/app-lock/code, used to read the current
# code from curl: curl -H "x-admin-key: $APP_LOCK_ADMIN_KEY" .../api/v1/app-lock/code
APP_LOCK_SECRET=
APP_LOCK_ADMIN_KEY=

# WebRTC TURN relay (strongly recommended for production — direct P2P fails
# behind symmetric NAT / carrier CGNAT). Deploy coturn or use a hosted TURN
# service, then list relay URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URL=
# Static long-term credentials (coturn lt-cred-mech)…
TURN_USERNAME=
TURN_CREDENTIAL=
# …or a coturn "use-auth-secret" shared secret for time-limited HMAC
# credentials (preferred — takes precedence over the static pair).
TURN_AUTH_SECRET=
TURN_CREDENTIAL_TTL_SEC=3600

# Expo push notifications (optional — without them calls/messages only reach
# currently-online devices). Access token from EAS dashboard > Accounts > Push.
EXPO_PUSH_ACCESS_TOKEN=

# Cloudflare R2 object storage (optional — files stay on local disk when unset).
# Create a bucket, an S3 auth token (Account > R2 > Manage API tokens) and bind
# a public custom domain or the r2.dev subdomain to the bucket for public reads.
# Songs/videos/images are then streamed straight from the bucket via
# R2_PUBLIC_BASE_URL; digital products are served through presigned URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=phoenix-media
# Public bucket base URL, no trailing slash (https://pub-<id>.r2.dev or custom domain)
R2_PUBLIC_BASE_URL=
# With R2 fully configured, `pnpm prisma db seed` mirrors the local asset
# libraries (thumbnails, chat fixtures, demo digital files) into the bucket and
# seeded records point at R2_PUBLIC_BASE_URL. Leave empty to keep serving them
# from local disk.
